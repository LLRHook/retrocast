<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.retrocast.backup</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>/ABSOLUTE/retrocast/retrocast/scripts/scheduled-backup.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>BACKUP_DIR</key><string>/ABSOLUTE/backups/retrocast</string>
    <key>COMPOSE_PROJECT_NAME</key><string>retrocast</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/ABSOLUTE/backups/retrocast/backup.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/backups/retrocast/backup-error.log</string>
</dict></plist>
