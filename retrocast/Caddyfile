{$DOMAIN:localhost} {
    # SigV4 signs both Host and path; preserve them unchanged.
    handle /retrocast/* {
        header X-Content-Type-Options nosniff
        header Content-Security-Policy "sandbox allow-downloads"
        @download method GET
        handle @download {
            reverse_proxy minio:9000 {
                header_up Host {http.request.host}
            }
        }
        respond 405
    }

    handle /api/* {
        reverse_proxy api:8080
    }

    handle /gateway {
        reverse_proxy api:8080
    }

    handle /metrics {
        respond 404
    }

    handle /docs* {
        reverse_proxy api:8080
    }

    handle /health {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:80
    }
}
