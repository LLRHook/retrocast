{$DOMAIN:localhost} {
    # SigV4 signs both Host and path; preserve them unchanged.
    handle /retrocast/* {
        header X-Content-Type-Options nosniff
        header Content-Security-Policy "sandbox allow-downloads"
        @download method GET
        handle @download {
            reverse_proxy minio:9000 {
                header_up Host {http.request.host}
            }
        }
        respond 405
    }

    @upload {
        method POST
        path /api/v1/channels/*/attachments
    }
    handle @upload {
        request_body {
            max_size 10551296
        }
        reverse_proxy api:8080
    }

    handle /api/* {
        request_body {
            max_size 1048576
        }
        reverse_proxy api:8080
    }

    handle /gateway {
        request_body {
            max_size 1048576
        }
        reverse_proxy api:8080
    }

    handle /metrics {
        respond 404
    }

    handle /docs* {
        request_body {
            max_size 1048576
        }
        reverse_proxy api:8080
    }

    handle /health {
        request_body {
            max_size 1048576
        }
        reverse_proxy api:8080
    }

    handle_errors {
        @large expression {err.status_code} == 413
        handle @large {
            header Content-Type application/json
            respond `{"error":{"code":"PAYLOAD_TOO_LARGE","message":"request body too large"}}` 413
        }
    }

    handle {
        reverse_proxy web:80
    }
}
