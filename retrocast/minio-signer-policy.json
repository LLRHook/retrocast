{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:GetObject"], "Resource": ["arn:aws:s3:::retrocast/*"]},
    {"Effect": "Deny", "NotAction": ["s3:GetObject"], "Resource": ["*"]},
    {"Effect": "Deny", "Action": ["s3:GetObject"], "NotResource": ["arn:aws:s3:::retrocast/*"]}
  ]
}
